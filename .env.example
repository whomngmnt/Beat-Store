# Copy this file to .env and put real values only there.
# This file is committed, so it holds placeholders only.

# Database: local Docker Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/beatstore

# Better Auth (Google sign-in)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First admin, created by the seed script. Put your real address only in .env.
ADMIN_EMAIL=admin@example.com

# Stripe, test mode keys only
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare R2 (S3 API). For the local storage server in docker-compose.yml
# use S3_ENDPOINT=http://localhost:8333, S3_ACCESS_KEY_ID=local-dev-key and
# S3_SECRET_ACCESS_KEY=local-dev-secret (local-only placeholders).
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=beatstore-previews
S3_PRIVATE_BUCKET=beatstore-files
# Public URL of the previews bucket, without a trailing slash. Leave it empty
# locally: previews then come from public/previews/.
PUBLIC_CDN_URL=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=
