# Copy this file to .env and put real values only there.
# This file is committed, so it holds placeholders only.

# Database: local Docker Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/beatstore

# Better Auth (Google sign-in). The secret signs session cookies: make one with
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The Google OAuth client (Google Cloud console, type "Web application") needs
# the redirect URI http://localhost:3000/api/auth/callback/google
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First admin, created by the seed script. Put your real address only in .env.
ADMIN_EMAIL=admin@example.com

# Stripe, test mode keys only
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare R2 (S3 API). For the local storage server in docker-compose.yml
# use S3_ENDPOINT=http://localhost:8333, S3_ACCESS_KEY_ID=local-dev-key and
# S3_SECRET_ACCESS_KEY=local-dev-secret (local-only placeholders). Then
# `pnpm storage:setup` creates both buckets and sets their CORS.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=beatstore-previews
S3_PRIVATE_BUCKET=beatstore-files
# Public URL of the public bucket (previews and covers), without a trailing
# slash. Locally: http://localhost:8333/beatstore-previews, after
# `pnpm storage:setup` and `pnpm demo:upload`. Left empty, previews come from
# public/previews/ and uploaded covers and previews don't show.
PUBLIC_CDN_URL=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=

# Contact page. Each one that's empty is left off the page. Put your real
# address and profile links only in .env, e.g. https://www.instagram.com/<name>
CONTACT_EMAIL=
INSTAGRAM_URL=
TIKTOK_URL=
YOUTUBE_URL=
